{
  "name": "osu-mania-io",
  "type": "module",
  "version": "1.0.0",
  "description": "TypeScript IO tools for osu!mania beatmaps and replays.",
  "author": "zzzzv",
  "license": "MIT",
  "homepage": "https://github.com/zzzzv/osu-mania-io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzzzv/osu-mania-io.git"
  },
  "bugs": {
    "url": "https://github.com/zzzzv/osu-mania-io/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./beatmap": {
      "types": "./dist/beatmap/index.d.mts",
      "import": "./dist/beatmap/index.mjs",
      "default": "./dist/beatmap/index.mjs"
    },
    "./mod": {
      "types": "./dist/mod/index.d.mts",
      "import": "./dist/mod/index.mjs",
      "default": "./dist/mod/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs",
      "default": "./dist/node.mjs"
    },
    "./replay": {
      "types": "./dist/replay/index.d.mts",
      "import": "./dist/replay/index.mjs",
      "default": "./dist/replay/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "dotnet-random-ts": "^0.1.0",
    "lzma-js-simple-v2": "^1.2.3",
    "osu-binary": "^0.1.0"
  }
}
